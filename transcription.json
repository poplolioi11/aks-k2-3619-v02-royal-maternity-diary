              "id": "006r01",
              "role": "body",
              "text": "○甲戌九月初一日"
            },
            {
              "id": "006r02",
              "role": "body",
              "text": "當日辰時當月産畜改貼於柱壁上馬韉移懸於丙方馬"
            },
            {
              "id": "006r03",
              "role": "body",
              "text": "皮亦爲移設丙首壬尾與次知內官眼同排置後卽爲"
            },
            {
              "id": "006r04",
              "role": "body",
              "text": "啓達　自淑儀房饋酒"
            },
            {
              "id": "006r05",
              "role": "body",
              "text": "○同日護産官崔聖任全世弘"
            },
            {
              "id": "006r06",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "006r07",
              "role": "body",
              "text": "○甲戌九月初三日醫官崔聖任"
            },
            {
              "id": "006r08",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "006r09",
              "role": "body",
              "text": "○同日醫女仁香診脈後出來言"
            },
            {
              "id": "006r10",
              "role": "body",
              "text": "崔淑儀氣候一樣平穩而脈度頗緩腹部稍下似有變動之"
            },
            {
              "id": "006r11",
              "role": "body",
              "text": "勢而兩脇下亦爲撑脹云故護産官崔聖任以此意微　稟劑入"
            },
            {
              "id": "006r12",
              "role": "body",
              "text": "達生散加益母草一錢五貼而　傳敎內醫官直宿以初六日進定"
            },
            {
              "id": "006r13",
              "role": "body",
              "text": "○甲戌九月初四日醫官崔聖任"
            },
            {
              "id": "006r14",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            }
