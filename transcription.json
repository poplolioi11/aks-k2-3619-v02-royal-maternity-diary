        {
          "side": "left",
          "units": [
            {
              "id": "003l01",
              "role": "body",
              "text": "○甲戌八月初一日"
            },
            {
              "id": "003l02",
              "role": "body",
              "text": "差備招掌務官"
            },
            {
              "id": "003l03",
              "role": "body",
              "text": "傳曰崔淑儀來九月當是産月産室諸事照例擧行事言于醫官"
            },
            {
              "id": "003l04",
              "role": "body",
              "text": "○同日"
            },
            {
              "id": "003l05",
              "role": "body",
              "text": "崔淑儀護産醫官望崔聖任鄭惟覺金汝器蛇油丸監劑官柳諶"
            },
            {
              "id": "003l06",
              "role": "body",
              "text": "鄭斗俊金慶華韓俊興玄萬運監捧官全世弘酒房官崔萬尚"
            },
            {
              "id": "003l07",
              "role": "body",
              "text": "掌務官邊永清金壽峯尹聖輔玄瑞夏金國賓申熙鎭掌務官"
            },
            {
              "id": "003l08",
              "role": "body",
              "text": "李道元酒房官趙興瑞李重蕃"
            },
            {
              "id": "003l09",
              "role": "body",
              "text": "落點崔聖任全世弘"
            },
            {
              "id": "003l10",
              "role": "body",
              "text": "○甲戌八月初二日醫官崔聖任全世弘詣"
            },
            {
              "id": "003l11",
              "role": "body",
              "text": "差備崔淑儀産室諸具當爲擧行而醫官等輪回問　安何以"
            },
            {
              "id": "003l12",
              "role": "body",
              "text": "爲之事"
            },
            {
              "id": "003l13",
              "role": "body",
              "text": "啓稟則依前例間一日爲之而醫官等直宿臨時分付事　下敎"
            },
            {
              "id": "003l14",
              "role": "body",
              "text": "○同日院"
            }
          ],
          "notes": [
            "前四欄頂部疊朱印，正文與印文分開。欄5小字『蛇油丸監劑官』、欄6「監捧官」「酒房官」、欄7末「掌務官」、欄8「酒房官」保持欄中順序並後續定位。『蕃』『賓』『熙鎭』『諶』為候讀。"
          ]
        }
      ]
    },
    {
      "image": 4,
      "label": "004",
      "id": "20170620052017459",
      "sha256": "e89a30cdf19bfd118b9532eed6a944029f71d7a8ec7a74ed95b3403bce838199",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620052017459.xml",
      "scan_width": 3213,
      "scan_height": 2493,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "004r01",
              "role": "body",
              "text": "啓目崔淑儀産室時湯藥書員尹以俊裴忠相醫女仁香承禮"
            },
            {
              "id": "004r02",
              "role": "body",
              "text": "等差下何如　啓依　允又"
            },
            {
              "id": "004r03",
              "role": "body",
              "text": "啓目崔淑儀産室排設時所用白馬皮一令馬韉一部羊毛氈"
            },
            {
              "id": "004r04",
              "role": "body",
              "text": "三浮六張付油芚二浮四張付油芚三浮捲草時所用命白米"
            },
            {
              "id": "004r05",
              "role": "body",
              "text": "一百斗命正銀八十兩命黃絲十斤命紬十疋令該曹急速進排"
            },
            {
              "id": "004r06",
              "role": "body",
              "text": "爲乎矣此外應入小々雜物乙良依前例提調直捧甘結取用"
            },
            {
              "id": "004r07",
              "role": "body",
              "text": "何如　啓依　允"
            },
            {
              "id": "004r08",
              "role": "body",
              "text": "○甲戌八月初三日醫官崔聖任全世弘"
            },
            {
              "id": "004r09",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004r10",
              "role": "body",
              "text": "○甲戌八月初五日醫官崔聖任"
            },
            {
              "id": "004r11",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004r12",
              "role": "body",
              "text": "○甲戌八月初七日醫官全世弘"
            },
            {
              "id": "004r13",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004r14",
              "role": "body",
              "text": "○甲戌八月初九日醫官崔聖任"
            }
          ],
          "notes": [
            "欄3『韉』、『氈』及欄4『芚』為候讀。欄6小重文呈小折筆，暫錄々，非句讀。"
          ]
        },
        {
          "side": "left",
          "units": [
            {
              "id": "004l01",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004l02",
              "role": "body",
              "text": "○甲戌八月十一日醫官全世弘"
            },
            {
              "id": "004l03",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004l04",
              "role": "body",
              "text": "○甲戌八月十三日醫官崔聖任"
            },
            {
              "id": "004l05",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004l06",
              "role": "body",
              "text": "○甲戌八月十五日醫官全世弘"
            },
            {
              "id": "004l07",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "004l08",
              "role": "body",
              "text": "○同日醫官崔聖任全世弘詣　差備"
            },
            {
              "id": "004l09",
              "role": "body",
              "text": "啓曰崔淑儀産室吉日自觀象監推擇以來明日排設之意敢　啓　答曰知道"
            },
            {
              "id": "004l10",
              "role": "body",
              "text": "○甲戌八月十六日辰時"
            },
            {
              "id": "004l11",
              "role": "body",
              "text": "宣政殿後泰和堂産室排設時次知內官金斗光醫官崔聖任全"
            },
            {
              "id": "004l12",
              "role": "body",
              "text": "世弘奏時官李後彬迴鑾官柳庭翰擇日官李貴賢書員"
            },
            {
              "id": "004l13",
              "role": "body",
              "text": "尹以俊裴忠相入室方位付二十四字而柱壁上先貼産畜次貼"
            },
            {
              "id": "004l14",
              "role": "body",
              "text": "催生符次貼借地法安産室吉方藏胎衣吉方釘加莫金懸"
            }
          ],
          "notes": [
            "欄12『迴鑾』『後彬』、欄13『産畜』及欄14『加莫金』候讀，與冊001相近僅作日後覆核線索。"
          ]
        }
      ]
    },
    {
      "image": 5,
      "label": "005",
      "id": "20170620052035149",
      "sha256": "4e78bf60f7f081a8f1f416da066dbf522d793617a193fea17f04097a613a2418",
      "descriptor": "https://jsg.aks.ac.kr/jsgimg/data/images/2017/06/20/dzi/20170620052035149.xml",
      "scan_width": 3211,
      "scan_height": 2489,
      "surfaces": [
        {
          "side": "right",
          "units": [
            {
              "id": "005r01",
              "role": "body",
              "text": "馬韉後先鋪黃草次鋪空石次鋪草席次鋪羊毛氈次鋪"
            },
            {
              "id": "005r02",
              "role": "body",
              "text": "油芚次鋪白馬皮乃於白馬皮頭下鋪生苧頭上左右鋪鼬鼠皮次鋪"
            },
            {
              "id": "005r03",
              "role": "body",
              "text": "剪邊空石一立後醫官全世弘讀借地法三度後出仍爲懸鈴"
            },
            {
              "id": "005r04",
              "role": "body",
              "text": "於寶慶堂且於産室門外懸草屨排釘三寸釘三箇而出"
            },
            {
              "id": "005r05",
              "role": "small-writing",
              "text": "草門乃泰堂前敷練門"
            },
            {
              "id": "005r06",
              "role": "body",
              "text": "排設後次知內官一員　差備內官一員護産官二員迴鑾官一員"
            },
            {
              "id": "005r07",
              "role": "body",
              "text": "擇日官一員奏時官一員別監二人書員二人醫女二人司僕諸員"
            },
            {
              "id": "005r08",
              "role": "body",
              "text": "三名奏時使令一名自　淑儀房饋酒"
            },
            {
              "id": "005r09",
              "role": "body",
              "text": "○同日護産官以直宿日期微　稟則卽令日官李貴賢推擇"
            },
            {
              "id": "005r10",
              "role": "body",
              "text": "以九月初九日爲之事　下敎"
            },
            {
              "id": "005r11",
              "role": "body",
              "text": "○甲戌八月十七日醫官崔聖任"
            },
            {
              "id": "005r12",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            },
            {
              "id": "005r13",
              "role": "body",
              "text": "○甲戌八月十九日醫官全世弘"
            },
            {
              "id": "005r14",
              "role": "body",
              "text": "崔淑儀房問　安答曰無事　饋酒"
            }
          ],
          "notes": [
            "欄4末及欄5頭小字雙行，連讀暫作『懸草門乃泰和堂前敷練門』，應另標小字座標。『敷練門』、『迴鑾』與『芚』均候讀。"
          ]
